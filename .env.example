# ============================================================
# Smart CV Dashboard — Environment Variables
# ============================================================
# انسخ هذا الملف إلى .env.local وأضف القيم الحقيقية
# ============================================================

# Supabase — من لوحة تحكم مشروعك على supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic Claude API — من console.anthropic.com
# مخفي على الـ server فقط — لا يظهر أبداً في الـ frontend
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# JWT Secret — أي نص عشوائي طويل وآمن
# يمكنك توليده بـ: openssl rand -base64 32
JWT_SECRET=change-this-to-a-very-long-random-string-in-production

# بيانات Super Admin الافتراضية (للـ Demo Mode)
ADMIN_EMAIL=superadmin@smartcv.ae
ADMIN_PASSWORD=Admin@2024!

# بيانات HR الافتراضية (للـ Demo Mode)
HR_EMAIL=hr@company.ae
HR_PASSWORD=HR@2024!
